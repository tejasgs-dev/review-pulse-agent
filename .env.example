# Copy to .env and fill in. .env is git-ignored.

# Claude API credentials (or use an `ant auth login` profile instead)
ANTHROPIC_API_KEY=

# The one address the weekly pulse is emailed to (yourself or an alias). Never hardcode it.
PULSE_RECIPIENT=

# The Google Doc the pulse is appended to each week: create it by hand once, then put its ID
# (or its URL) here. The app never creates a doc; publishing fails if this is empty.
PULSE_DOC_ID=

# API key for the Docs + Gmail MCP server (gworkspace-mcp on Render; URL in config/pulse.yaml).
# It is the server's MCP_API_KEY. Never commit it.
PULSE_MCP_API_KEY=
